{
  "manifest_version": 3,
  "name": "Cyber-Safety Dark Pattern & Fee Detector",
  "version": "1.3",
  "description": "Scans e-commerce checkouts and maintains a community index of dark patterns.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["overlay.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}